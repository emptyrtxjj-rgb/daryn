# Ключ из Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Актуальная модель Gemini и запасные модели через запятую
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=110000

# Сервер
PORT=3000
MAX_FILE_MB=15
AI_RATE_LIMIT=30

# Поставь 1, если приложение работает за reverse-proxy (Render/Railway/Nginx)
TRUST_PROXY=0
